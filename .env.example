# Temple Management System - Environment Variables Example
# Copy this file to .env and configure your database and server credentials

# MongoDB Atlas or Local MongoDB Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=temple_management

# Flask Session Security Key
SECRET_KEY=replace_with_a_secure_random_key_in_production

# Web Server Port
PORT=4450
